# .NET backend (../backend) — read-only integration, called over HTTP only.
BACKEND_BASE=http://localhost:5100
BACKEND_INTERNAL_API_KEY=

# Direct, read-only Postgres access — only for aggregate stats the backend has no
# endpoint for (e.g. user counts). See lib/db-client.ts.
DATABASE_URL=postgres://user:password@127.0.0.1:5438/nearsip

# Public URL of the NearSip app (nearsip/frontend) — used for each store's QR Code
# ({NEARSIP_APP_URL}/{storeId}/home) in the "User Partners" menu. Empty = falls back to NEARSIP_FRONTEND_URL.
NEARSIP_APP_URL=

# Secret that signs partner (store) login cookies — at least 32 chars, e.g. `openssl rand -base64 48`.
# Empty = partner (store) accounts cannot log in; the original dashboard accounts are unaffected.
PARTNER_SESSION_SECRET=
